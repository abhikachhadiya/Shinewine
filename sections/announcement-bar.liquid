{% if section.settings.show and section.settings.text != blank %}
<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="container">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {% else %}
      <span>{{ section.settings.text }}</span>
    {% endif %}
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "Show announcement", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $50" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}

{% stylesheet %}
.announcement-bar { background: #111; color: #fff; font-size: 14px; padding: 8px 0; text-align: center; }
.announcement-bar a { color: inherit; text-decoration: underline; }
{% endstylesheet %}